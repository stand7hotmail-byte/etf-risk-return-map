# Explicitly ignore directories that should never be deployed.
security-check/
venv/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.db
*.sqlite
*.sqlite3
data/
sql_app.db

# Ignore everything by default.
*

# Then, whitelist the necessary files and directories for deployment.
!app.yaml
!main.py
!requirements.txt
!etf_list.csv

# Application, static, and template directories
!app/
!app/**
!static/
!static/**
!templates/
!templates/**

# Keep these files for reference.
!.gcloudignore
!.gitignore